<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/aboutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/aboutBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/about_back"
                    android:src="@drawable/ic_back"
                    android:tint="@color/ink" />

                <TextView
                    android:id="@+id/aboutHeading"
                    style="@style/S1.Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="@string/about_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/aboutNotice"
                style="@style/S1.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_banner_error"
                android:padding="16dp"
                android:visibility="gone" />

            <!-- Identity -->
            <LinearLayout
                style="@style/S1.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <!-- Decorative: the name below identifies the app. -->
                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/app_icon" />

                <TextView
                    android:id="@+id/aboutName"
                    style="@style/S1.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/header_title" />

                <TextView
                    android:id="@+id/aboutVersion"
                    style="@style/S1.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal" />

                <TextView
                    style="@style/S1.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_horizontal"
                    android:text="@string/about_description" />
            </LinearLayout>

            <!-- Author and project links -->
            <LinearLayout
                style="@style/S1.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="0dp">

                <TextView
                    style="@style/S1.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/about_developed_by" />

                <include
                    android:id="@+id/aboutDeveloper"
                    layout="@layout/row_tool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="56dp"
                    android:background="@color/outline" />

                <include
                    android:id="@+id/aboutSource"
                    layout="@layout/row_tool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="56dp"
                    android:background="@color/outline" />

                <include
                    android:id="@+id/aboutIssue"
                    layout="@layout/row_tool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="56dp"
                    android:background="@color/outline" />

                <include
                    android:id="@+id/aboutCredit"
                    layout="@layout/row_tool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Offline license -->
            <LinearLayout
                style="@style/S1.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="0dp">

                <include
                    android:id="@+id/aboutLicenseRow"
                    layout="@layout/row_tool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/aboutLicenseText"
                    style="@style/S1.Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/ink_secondary"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Same notices as the Mac About window -->
            <TextView
                style="@style/S1.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text="@string/about_notice_open_source" />

            <TextView
                style="@style/S1.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="@string/about_notice_credit" />

            <TextView
                style="@style/S1.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="@string/about_notice_affiliation" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/aboutScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/scrim"
        android:importantForAccessibility="no" />
</FrameLayout>
